{
  "source": {
    "root_dir": "D:/meteo/product",
    "directory_template": "",
    "file_pattern": "*.nc"
  },
  "batch": {
    "lookback_hours": 12
  },
  "output": {
    "root_dir": "D:/meteo/output",
    "model_directory": "cpefs",
    "filename_prefix": "output_CPEFS"
  },
  "state": {
    "directory": "state",
    "filename_template": "processed_{YYYYMMDD}.json",
    "retention_days": 30
  },
  "plot": {
    "title_prefix": "CMA-CPEFS v2.0",
    "footer": "CPAS",
    "extent": [107.48, 123.5, 32.98, 47.02],
    "latitude": "lat",
    "longitude": "lon",
    "level": "level"
  },
  "boundaries": {
    "province_file": "geojson/中国_省.geojson",
    "city_file": "geojson/中国_市.geojson",
    "tianjin_district_file": "geojson/天津市_县.geojson",
    "country_linewidth": 2.1,
    "province_linewidth": 2.1,
    "city_linewidth": 0.55,
    "district_linewidth": 0.55
  },
  "variables": [
    {
      "source": "cloudtopt",
      "name": "cloudtopt",
      "dimension": "2D",
      "display_name": "云顶温度",
      "plot_unit": "°C",
      "color_scale": 2,
      "invalid_values": []
    },
    {
      "source": "cloudtoph",
      "name": "cloudtoph",
      "dimension": "2D",
      "display_name": "云顶高度",
      "plot_unit": "km",
      "color_scale": 1,
      "invalid_values": []
    },
    {
      "source": "cband",
      "name": "cband",
      "dimension": "2D",
      "display_name": "云带",
      "plot_unit": "mm",
      "color_scale": 1,
      "invalid_values": []
    },
    {
      "source": "vil",
      "name": "vil",
      "dimension": "2D",
      "display_name": "垂直累计液态水",
      "plot_unit": "mm",
      "color_scale": 1,
      "invalid_values": []
    },
    {
      "source": "visl",
      "name": "visl",
      "dimension": "2D",
      "display_name": "垂直累计过冷水",
      "plot_unit": "mm",
      "color_scale": 1,
      "invalid_values": []
    },
    {
      "source": "cloudboth",
      "name": "cloudboth",
      "dimension": "2D",
      "display_name": "云底高度",
      "plot_unit": "km",
      "color_scale": 1,
      "invalid_values": []
    },
    {
      "source": "cloudbott",
      "name": "cloudbott",
      "dimension": "2D",
      "display_name": "云底温度",
      "plot_unit": "°C",
      "color_scale": 2,
      "invalid_values": []
    },
    {
      "source": "max_dbz",
      "name": "max_dbz",
      "dimension": "2D",
      "display_name": "垂直最大反射率",
      "plot_unit": "dBZ",
      "color_scale": 3,
      "invalid_values": []
    },
    {
      "source": "Tc",
      "name": "Tc",
      "dimension": "3D",
      "display_name": "温度",
      "plot_unit": "°C",
      "color_scale": 5,
      "invalid_values": []
    },
    {
      "source": "dbz",
      "name": "dbz",
      "dimension": "3D",
      "display_name": "雷达反射率",
      "plot_unit": "dBZ",
      "color_scale": 3,
      "invalid_values": []
    },
    {
      "source": "qcloud",
      "name": "qcloud",
      "dimension": "3D",
      "display_name": "云水混合比",
      "plot_unit": "g/kg",
      "color_scale": 4,
      "invalid_values": []
    }
  ]
}
